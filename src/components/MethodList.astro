---
interface Props {
  methods?: string[];
  class?: string;
}

const { methods, class: className } = Astro.props;

// Absent and empty are the same case: render nothing, so no margin is left
// behind by an element that exists but holds no items.
const items = methods ?? [];
---

{
  items.length > 0 && (
    <p class:list={["methods", className]}>
      {items.map((method) => (
        <span class="method">{method}</span>
      ))}
    </p>
  )
}

<style>
  /* A midline dot separates items; no box of any kind around one. These are
     annotations, not controls, so nothing here is focusable or interactive. */
  .methods {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-2);
    row-gap: var(--s-1);
    margin: 0;
    font-family: var(--face-data);
    font-size: var(--size-1);
    color: var(--muted);
  }

  .method {
    white-space: nowrap;
  }

  /* The dot rides with the item that follows it and inherits its nowrap, so a
     separator never lands alone at the start or end of a wrapped line. */
  .method + .method::before {
    content: "·";
    margin-right: var(--s-2);
    color: color-mix(in srgb, var(--muted) 65%, transparent);
  }
</style>
