---
// Persistent random walk of migrating cells.
// Each primary track corresponds to one project in the list; hovering or
// focusing a project highlights its track.
const { trackCount = 4 } = Astro.props;
---

<figure class="field">
  <p class="plate-label">Fig. 1 &mdash; simulated tracks</p>
  <canvas id="migration" data-tracks={trackCount} aria-hidden="true"></canvas>
  <figcaption class="readout">
    <span class="datum" id="clock">t 0 s</span>
    <span class="bar" aria-hidden="true"></span>
    <span class="datum">12 µm</span>
  </figcaption>
  <p class="sr">
    An animated field of simulated cell trajectories. Each highlighted path
    corresponds to one project listed alongside.
  </p>
</figure>

<style>
  .field {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .plate-label {
    margin: 0;
    font-family: var(--face-data);
    font-size: var(--size-1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--ink);
  }

  #migration {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    border: 1px solid var(--hair);
    background: var(--plate);
  }

  .readout {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--face-data);
    font-size: var(--size-1);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .datum {
    white-space: nowrap;
  }

  .bar {
    flex: 0 0 34px;
    height: 1px;
    background: var(--muted);
    margin-left: auto;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 899px) {
    #migration {
      aspect-ratio: 16 / 9;
    }
  }
</style>

<script>
  interface Cell {
    primary: boolean;
    index: number;
    x: number;
    y: number;
    theta: number;
    sigma: number;
    speed: number;
    trail: number[];
  }

  const element = document.getElementById("migration");
  const clock = document.getElementById("clock");
  const context =
    element instanceof HTMLCanvasElement ? element.getContext("2d") : null;

  if (element instanceof HTMLCanvasElement && context) {
    // Bound to explicitly typed consts: narrowing does not reach into the
    // nested step/draw/resize closures, but an annotated const does.
    const canvas: HTMLCanvasElement = element;
    const ctx: CanvasRenderingContext2D = context;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const primary = Number(canvas.dataset.tracks || 4);
    const extra = 20;
    const styles = getComputedStyle(document.documentElement);
    const INK = styles.getPropertyValue("--ink").trim();
    const COLLAGEN = styles.getPropertyValue("--collagen").trim();
    const TRACK = styles.getPropertyValue("--track").trim();
    const MUTED = styles.getPropertyValue("--muted").trim();

    let w = 0;
    let h = 0;
    let cells: Cell[] = [];
    let active = -1;
    let frame = 0;

    // Box–Muller transform for a normal deviate.
    function gauss() {
      let u = 0;
      let v = 0;
      while (u === 0) u = Math.random();
      while (v === 0) v = Math.random();
      return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    }

    function seed() {
      cells = [];
      const total = primary + extra;
      for (let i = 0; i < total; i += 1) {
        const isPrimary = i < primary;
        cells.push({
          primary: isPrimary,
          index: i,
          x: w * (0.12 + 0.76 * Math.random()),
          y: h * (0.12 + 0.76 * Math.random()),
          theta: Math.random() * Math.PI * 2,
          // Persistence: lower sigma keeps the walk directed for longer.
          sigma: isPrimary ? 0.16 : 0.3,
          speed: (isPrimary ? 0.72 : 0.46) * (0.85 + 0.3 * Math.random()),
          trail: [],
        });
      }
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
      if (reduced) {
        for (let i = 0; i < 420; i += 1) step();
        draw();
      }
    }

    function step() {
      for (const c of cells) {
        c.theta += gauss() * c.sigma;
        c.x += Math.cos(c.theta) * c.speed;
        c.y += Math.sin(c.theta) * c.speed;

        // Reflect at the edges so tracks stay in the field of view.
        if (c.x < 6 || c.x > w - 6) {
          c.theta = Math.PI - c.theta;
          c.x = Math.max(6, Math.min(w - 6, c.x));
        }
        if (c.y < 6 || c.y > h - 6) {
          c.theta = -c.theta;
          c.y = Math.max(6, Math.min(h - 6, c.y));
        }

        c.trail.push(c.x, c.y);
        if (c.trail.length > 520) c.trail.splice(0, 2);
      }
      frame += 1;
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      ctx.lineCap = "round";
      ctx.lineJoin = "round";

      for (const c of cells) {
        const isActive = c.primary && c.index === active;
        const dim = active >= 0 && !isActive;

        ctx.beginPath();
        for (let i = 0; i < c.trail.length; i += 2) {
          const x = c.trail[i];
          const y = c.trail[i + 1];
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }

        if (isActive) {
          ctx.strokeStyle = TRACK;
          ctx.lineWidth = 1.6;
          ctx.globalAlpha = 0.95;
        } else if (c.primary) {
          ctx.strokeStyle = COLLAGEN;
          ctx.lineWidth = 1.1;
          ctx.globalAlpha = dim ? 0.22 : 0.62;
        } else {
          ctx.strokeStyle = MUTED;
          ctx.lineWidth = 0.7;
          ctx.globalAlpha = dim ? 0.12 : 0.3;
        }
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(c.x, c.y, isActive ? 3.2 : c.primary ? 2.1 : 1.4, 0, Math.PI * 2);
        ctx.fillStyle = isActive ? TRACK : c.primary ? COLLAGEN : MUTED;
        ctx.globalAlpha = dim ? 0.25 : 0.9;
        ctx.fill();
      }

      ctx.globalAlpha = 1;
      ctx.strokeStyle = INK;
    }

    function loop() {
      step();
      draw();
      if (clock && frame % 6 === 0) {
        clock.textContent = `t ${Math.round(frame / 3)} s`;
      }
      requestAnimationFrame(loop);
    }

    // Projects announce which track they own via a custom event.
    document.addEventListener("track:enter", (event) => {
      active = (event as CustomEvent<{ index: number }>).detail.index;
      if (reduced) draw();
    });
    document.addEventListener("track:leave", () => {
      active = -1;
      if (reduced) draw();
    });

    const observer = new ResizeObserver(resize);
    observer.observe(canvas);
    resize();
    if (!reduced) loop();
  }
</script>