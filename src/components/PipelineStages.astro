---
import type { CollectionEntry } from "astro:content";
import DpMatrix from "./figures/DpMatrix.astro";
import MsaColumns from "./figures/MsaColumns.astro";
import Supermatrix from "./figures/Supermatrix.astro";
import Clustering from "./figures/Clustering.astro";
import Dendrogram from "./figures/Dendrogram.astro";

type Pipeline = NonNullable<CollectionEntry<"projects">["data"]["pipeline"]>;

interface Props {
  stages: Pipeline;
}

const { stages } = Astro.props;

const FIGURES = {
  "dp-matrix": DpMatrix,
  "msa-columns": MsaColumns,
  supermatrix: Supermatrix,
  clustering: Clustering,
  dendrogram: Dendrogram,
} as const;
---

<ol class="stages" aria-label="Pipeline stages, in order">
  {
    stages.map((stage) => {
      const Figure = FIGURES[stage.figure];
      return (
        <li class="stage">
          <div class="row">
            <span class="figure">
              <Figure />
            </span>
            <div class="body">
              <div class="top">
                <h2 class="label">{stage.label}</h2>
                <p class="io">
                  {stage.input}
                  <span class="sr"> to </span>
                  <span class="arrow" aria-hidden="true">&rarr;</span>
                  {stage.output}
                </p>
              </div>
              <p class="repo">
                <a href={stage.url} rel="noopener">
                  {stage.repo}
                </a>
                <span class="ext" aria-hidden="true">&#8599;</span>
              </p>
              <p class="blurb">{stage.blurb}</p>
            </div>
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .stages {
    margin: var(--s-6) 0 0;
    padding: 0;
  }

  /*
   * The li stays `display: list-item` so the `list-item` counter keeps
   * incrementing — the number below is the list's own, not a hand-written one.
   * The grid therefore lives on an inner wrapper.
   */
  .stage {
    display: list-item;
    list-style: none;
    position: relative;
    padding: 0 0 var(--s-5) var(--s-5);
  }

  .stage::before {
    content: counter(list-item);
    position: absolute;
    left: 0;
    top: 0;
    /* Number and rule share one centre line: the digit is centred in this
       box, and the rule below sits on the same box's midpoint. */
    width: 1.5rem;
    text-align: center;
    font-family: var(--face-data);
    font-size: var(--size-1);
    font-variant-numeric: tabular-nums;
    line-height: 1.7;
    color: var(--muted);
  }

  /* Rule segment owned by this stage; the last one draws none, so the line
     stops at the final stage instead of running past it. */
  .stage::after {
    content: "";
    position: absolute;
    /* Half of the number box, less half the rule's own width. */
    left: calc(0.75rem - 0.5px);
    top: 1.8rem;
    bottom: 0;
    width: 1px;
    background: var(--muted);
  }

  .stage:last-child::after {
    content: none;
  }

  .stage:hover::before,
  .stage:focus-within::before {
    color: var(--track);
  }

  .stage:hover::after,
  .stage:focus-within::after {
    background: var(--track);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--s-2);
  }

  .figure {
    display: none;
  }

  .top {
    display: grid;
    gap: var(--s-1);
  }

  .label {
    font-family: var(--face-text);
    font-weight: 500;
    font-size: var(--size-2);
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--ink);
    margin: 0;
  }

  .io {
    margin: 0;
    font-family: var(--face-data);
    font-size: var(--size-1);
    color: var(--muted);
  }

  .arrow {
    padding: 0 0.35em;
  }

  .repo {
    margin: 0;
    font-family: var(--face-data);
    font-size: var(--size-1);
  }

  .repo a {
    color: var(--collagen);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .ext {
    padding-left: 0.35em;
    color: var(--muted);
  }

  .blurb {
    margin: 0;
    /* Keeps the measure short enough to scan against the figure. */
    max-width: 58ch;
    color: var(--ink-soft);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 700px) {
    .row {
      grid-template-columns: 48px minmax(0, 1fr);
      column-gap: var(--s-3);
      align-items: start;
    }

    .figure {
      display: block;
      grid-row: 1 / span 3;
    }

    .figure :global(svg) {
      display: block;
      width: 48px;
      height: 48px;
    }

    /* input → output shares the label's baseline, pinned to the right edge. */
    .top {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      column-gap: var(--s-4);
    }

    .io {
      text-align: right;
    }
  }
</style>
