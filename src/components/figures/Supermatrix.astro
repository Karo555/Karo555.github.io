---
// Three per-gene alignments of differing width, joined edge to edge into one
// matrix. The partition boundaries are the only thing the join adds.
---

<svg viewBox="0 0 96 96" fill="none" aria-hidden="true" focusable="false">
  <g stroke="var(--collagen)" stroke-width="1.2">
    <rect x="6" y="30" width="84" height="36" />
    <line x1="6" y1="42" x2="90" y2="42" />
    <line x1="6" y1="54" x2="90" y2="54" />
  </g>
  <g stroke="var(--track)" stroke-width="1.5">
    <line x1="36" y1="30" x2="36" y2="66" />
    <line x1="58" y1="30" x2="58" y2="66" />
  </g>
</svg>
