---
// Six observations. The closest pair is the one average linkage merges first,
// so it is joined and enclosed; everything else is still a singleton.
const points = [
  [18, 26],
  [30, 34],
  [62, 20],
  [78, 44],
  [24, 72],
  [66, 74],
];
---

<svg viewBox="0 0 96 96" fill="none" aria-hidden="true" focusable="false">
  <g fill="var(--collagen)">
    {points.map(([cx, cy]) => <circle cx={cx} cy={cy} r="2.2" />)}
  </g>
  <g stroke="var(--track)" stroke-width="1.4">
    <line x1="18" y1="26" x2="30" y2="34" />
    <ellipse cx="24" cy="30" rx="13" ry="7.5" transform="rotate(33.7 24 30)" />
  </g>
</svg>
