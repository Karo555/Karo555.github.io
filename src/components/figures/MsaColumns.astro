---
// Four aligned rows of residues. Columns 2 and 6 carry a residue in every
// row, so they are the conserved ones; the blanks elsewhere are gaps.
const columns = [8, 18, 28, 38, 48, 58, 68, 78];
const rows = [22, 40, 58, 76];
const conserved = new Set([2, 6]);
const gaps = new Set(["0-7", "1-4", "2-5", "3-1"]);
---

<svg viewBox="0 0 96 96" fill="none" aria-hidden="true" focusable="false">
  {
    rows.map((y, row) =>
      columns.map((x, column) =>
        gaps.has(`${row}-${column}`) ? null : (
          <line
            x1={x}
            y1={y}
            x2={x + 7}
            y2={y}
            stroke={conserved.has(column) ? "var(--track)" : "var(--collagen)"}
            stroke-width="1.5"
          />
        )
      )
    )
  }
</svg>
