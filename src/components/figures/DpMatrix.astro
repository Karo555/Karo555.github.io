---
// Pairwise global alignment: the full scoring matrix, with the traceback
// running from the bottom-right corner back to the origin.
const gridlines = Array.from({ length: 9 }, (_, i) => 8 + i * 10);
const traceback =
  "88,88 88,78 78,78 78,68 68,68 68,48 58,48 58,38 48,38 48,28 38,28 28,28 28,18 18,18 18,8 8,8";
---

<svg viewBox="0 0 96 96" fill="none" aria-hidden="true" focusable="false">
  <g stroke="var(--collagen)" stroke-width="1">
    {gridlines.map((p) => <line x1={p} y1="8" x2={p} y2="88" />)}
    {gridlines.map((p) => <line x1="8" y1={p} x2="88" y2={p} />)}
  </g>
  <polyline
    points={traceback}
    stroke="var(--track)"
    stroke-width="1.5"
    stroke-linecap="square"
  />
</svg>
