---
// Five leaves joined by right-angled branches, with one root-to-leaf path
// traced to show the depth the clustering implies.
const path = "10,54.75 24,54.75 24,34.5 46,34.5 46,21 64,21 64,12 84,12";
---

<svg viewBox="0 0 96 96" fill="none" aria-hidden="true" focusable="false">
  <g stroke="var(--collagen)" stroke-width="1.2" stroke-linecap="square">
    <line x1="84" y1="12" x2="64" y2="12" />
    <line x1="84" y1="30" x2="64" y2="30" />
    <line x1="64" y1="12" x2="64" y2="30" />
    <line x1="64" y1="21" x2="46" y2="21" />
    <line x1="84" y1="48" x2="46" y2="48" />
    <line x1="46" y1="21" x2="46" y2="48" />
    <line x1="46" y1="34.5" x2="24" y2="34.5" />
    <line x1="84" y1="66" x2="58" y2="66" />
    <line x1="84" y1="84" x2="58" y2="84" />
    <line x1="58" y1="66" x2="58" y2="84" />
    <line x1="58" y1="75" x2="24" y2="75" />
    <line x1="24" y1="34.5" x2="24" y2="75" />
    <line x1="24" y1="54.75" x2="10" y2="54.75" />
  </g>
  <polyline
    points={path}
    stroke="var(--track)"
    stroke-width="1.5"
    stroke-linecap="square"
  />
</svg>
