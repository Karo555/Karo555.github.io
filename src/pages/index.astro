---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import MigrationCanvas from "../components/MigrationCanvas.astro";
import PublicationList from "../components/PublicationList.astro";
import MethodList from "../components/MethodList.astro";
import { warnInconsistentMethods } from "../lib/methods";

const entries = await getCollection("projects");
const projects = entries.sort((a, b) => a.data.order - b.data.order);

// The fields are filled in by hand, so a half-populated entry is expected mid-
// edit. Drop anything that would render a dead DOI link and say so in the build
// log; if that empties the collection the section is omitted entirely, rather
// than leaving a heading standing over nothing.
const paperEntries = await getCollection("papers");
const papers = paperEntries
  .filter((entry) => {
    const usable = entry.data.title.trim() !== "";
    if (!usable) {
      console.warn(`[papers] skipping "${entry.id}": title must be filled in.`);
    }
    return usable;
  })
  .map((entry) => ({ id: entry.id, ...entry.data }));

// Runs across both collections, so drift between a project and a paper is caught
// as well as drift within either one.
warnInconsistentMethods(
  [...entries, ...paperEntries].map((entry) => ({
    id: entry.id,
    methods: entry.data.methods,
  }))
);
---

<Base title="Karo — computational biology and AI safety">
  <main class="shell">
    <div class="field-column">
      <nav class="anchors" aria-label="Sections">
        <a href="#work">Work</a>
        {papers.length > 0 && <a href="#publications">Publications</a>}
      </nav>
      <MigrationCanvas trackCount={projects.length} />
    </div>

    <div class="text-column">
      <header class="intro">
        <h1>Research scientist</h1>
        <p class="lede">
          AI x Bio | Biosecurity
        </p>
      </header>

      <section class="now" aria-labelledby="now-heading">
        <h2 id="now-heading" class="section-title">Current work</h2>
        <a class="tile" href="/current/">
          <h3 class="tile-title">In progress</h3>
          <p class="tile-note">
            Work that is underway and not yet written up.
          </p>
          <span class="tile-cue">See what I am working on</span>
        </a>
      </section>

      <section class="work" id="work" aria-labelledby="work-heading">
        <h2 id="work-heading" class="section-title">Selected work</h2>
        <ul class="tracks">
          {
            projects.map((project, index) => (
              <li class="track" data-index={index}>
                <a class="track-link" href={`/projects/${project.id}/`}>
                  <h3 class="track-title">{project.data.title}</h3>
                  <p class="track-note">{project.data.note}</p>
                  <MethodList
                    methods={project.data.methods}
                    class="track-methods"
                  />
                  <p class="track-status">{project.data.status}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <p class="pending">
        Drug discovery and AI safety work is in preparation and not yet public.
      </p>

      {
        papers.length > 0 && (
          <section
            class="pubs-section"
            id="publications"
            aria-labelledby="pubs-heading"
          >
            <h2 id="pubs-heading" class="section-title">
              Publications
            </h2>
            <PublicationList papers={papers} />
          </section>
        )
      }

      <footer class="foot">
        <a href="mailto:nowackadev@gmail.com">Email</a>
        <a href="https://github.com/Karo555">GitHub</a>
      </footer>
    </div>
  </main>
</Base>

<style>
  .shell {
    display: grid;
    gap: var(--s-5);
    max-width: 1180px;
    margin: 0 auto;
    padding: var(--s-5) var(--s-4) var(--s-6);
  }

  @media (min-width: 900px) {
    .shell {
      grid-template-columns: minmax(260px, 34%) 1fr;
      gap: var(--s-6);
      padding-top: var(--s-6);
    }

    .field-column {
      position: sticky;
      top: var(--s-5);
      align-self: start;
    }
  }

  .text-column {
    max-width: var(--measure);
  }

  /* The sections are adjacent once the layout collapses, so the anchors only
     earn their place at the width where the field column exists. */
  .anchors {
    display: none;
  }

  @media (min-width: 900px) {
    .anchors {
      display: grid;
      justify-items: start;
      gap: var(--s-2);
      margin-bottom: var(--s-4);
    }
  }

  .anchors a {
    font-family: var(--face-text);
    font-size: var(--size-1);
    color: var(--muted);
    text-decoration: none;
    transition: color 120ms linear;
  }

  .anchors a:hover,
  .anchors a:focus-visible {
    color: var(--track);
  }

  /* Set by the observer below: a colour change only, so nothing moves and the
     reduced-motion case needs no separate handling. */
  .anchors a.is-active {
    color: var(--ink);
  }

  .work,
  .pubs-section {
    scroll-margin-top: var(--s-5);
  }

  .pubs-section {
    margin-top: var(--s-6);
  }

  .intro h1 {
    font-size: var(--size-5);
    margin-bottom: var(--s-3);
  }

  .lede {
    font-size: var(--size-3);
    line-height: 1.4;
    color: color-mix(in srgb, var(--ink) 78%, var(--bg));
    margin: 0;
    max-width: 34ch;
  }

  .now {
    margin-top: var(--s-6);
  }

  /* A bordered plate, not a .track row: the tracks own data-index and drive
     the canvas, and an extra one would dispatch an out-of-range index. */
  .tile {
    display: block;
    padding: var(--s-4);
    background: var(--plate);
    border: 1px solid var(--hair);
    border-left: 2px solid var(--collagen);
    text-decoration: none;
    transition: border-left-color 120ms linear, transform 120ms linear;
  }

  .tile:hover,
  .tile:focus-visible {
    border-left-color: var(--track);
    transform: translateX(2px);
  }

  .tile-title {
    font-size: var(--size-3);
    margin-bottom: var(--s-2);
  }

  .tile-note {
    margin: 0 0 var(--s-3);
    max-width: 52ch;
    color: color-mix(in srgb, var(--ink) 80%, var(--bg));
  }

  .tile-cue {
    font-family: var(--face-data);
    font-size: var(--size-1);
    color: var(--muted);
  }

  .tile:hover .tile-cue,
  .tile:focus-visible .tile-cue {
    color: var(--track);
  }

  .work {
    margin-top: var(--s-6);
  }

  .section-title {
    font-family: var(--face-text);
    font-weight: 500;
    font-size: var(--size-1);
    color: var(--muted);
    letter-spacing: 0;
    margin-bottom: var(--s-3);
  }

  .tracks {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .track {
    border-top: 1px solid color-mix(in srgb, var(--muted) 50%, transparent);
  }

  .track:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--muted) 50%, transparent);
  }

  .track-link {
    display: block;
    padding: var(--s-4) 0 var(--s-4) var(--s-3);
    border-left: 2px solid transparent;
    text-decoration: none;
    transition: border-color 120ms linear, padding-left 120ms linear;
  }

  .track-link:hover,
  .track-link:focus-visible {
    border-left-color: var(--track);
    padding-left: var(--s-4);
  }

  .track-title {
    font-size: var(--size-4);
    margin-bottom: var(--s-2);
  }

  .track-note {
    margin: 0 0 var(--s-2);
    max-width: 52ch;
    color: color-mix(in srgb, var(--ink) 80%, var(--bg));
  }

  .track-methods {
    margin-bottom: var(--s-2);
  }

  .track-status {
    margin: 0;
    font-family: var(--face-data);
    font-size: var(--size-1);
    color: var(--muted);
  }

  .pending {
    margin: var(--s-4) 0 0;
    font-size: var(--size-1);
    color: var(--muted);
  }

  .foot {
    margin-top: var(--s-6);
    display: flex;
    gap: var(--s-4);
    font-size: var(--size-1);
  }

  .foot a {
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* Live links only: the placeholder href="#" stays inert, and picks the
     hover up on its own once it points somewhere. */
  .foot a:not([href="#"]):hover,
  .foot a:not([href="#"]):focus-visible {
    color: var(--track);
  }
</style>

<script>
  const tracks = document.querySelectorAll<HTMLElement>(".track");

  tracks.forEach((track) => {
    const index = Number(track.dataset.index);
    const enter = () =>
      document.dispatchEvent(
        new CustomEvent("track:enter", { detail: { index } })
      );
    const leave = () => document.dispatchEvent(new CustomEvent("track:leave"));

    track.addEventListener("pointerenter", enter);
    track.addEventListener("pointerleave", leave);
    track.addEventListener("focusin", enter);
    track.addEventListener("focusout", leave);
  });
</script>

<script>
  // Highlights whichever headed section is nearest the top of the viewport.
  // The band set by rootMargin is what decides "current", so no scroll
  // listener is needed and the callback only fires on a crossing.
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".anchors a")
  );

  const sections = new Map<Element, HTMLAnchorElement>();

  links.forEach((link) => {
    const id = link.getAttribute("href")?.slice(1);
    const section = id ? document.getElementById(id) : null;
    if (section) sections.set(section, link);
  });

  if (sections.size > 0) {
    const visible = new Set<Element>();
    // Document order, so ties resolve to the section higher up the page.
    const ordered = Array.from(sections.keys());

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target);
          else visible.delete(entry.target);
        });

        const active = ordered.find((section) => visible.has(section));
        links.forEach((link) => link.classList.remove("is-active"));
        if (active) sections.get(active)?.classList.add("is-active");
      },
      { rootMargin: "-25% 0px -60% 0px" }
    );

    sections.forEach((_link, section) => observer.observe(section));
  }
</script>